# 复制为 .env 并填写你拥有的 API Key（.env 已被 gitignore，不会提交到仓库）。
# 默认顺序：GPT → DeepSeek → WorkBuddy/TokenHub → 千问；千问始终是最终兜底。
LLM_PROVIDER_ORDER=gpt,deepseek,workbuddy,qwen

# GPT：保留旧版 LLM_* 名称，已有部署不用迁移 Secret。
LLM_API_KEY=sk-你的OpenAI_API_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=medium

# DeepSeek：默认使用官方 OpenAI 兼容接口。
DEEPSEEK_API_KEY=sk-你的DeepSeek_API_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# WorkBuddy 对应腾讯云 TokenHub 个人 Token Plan；模型和地址可按套餐覆盖。
WORKBUDDY_API_KEY=sk-tp-你的TokenHub_API_key
WORKBUDDY_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3
WORKBUDDY_MODEL=hy3

# 千问最终兜底：默认使用阿里云百炼北京共享域名。
QWEN_API_KEY=sk-你的百炼_API_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# 单供应商请求重试；确认额度不足后会熔断并切换下一供应商。
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1

# 图像生成独立配置：每篇尝试 1 张封面，正文按需生成 0-5 张插图
IMAGE_API_KEY=sk-你的OpenAI图像接口key
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
IMAGE_TIMEOUT_SECONDS=240
IMAGE_MAX_RETRIES=1

# 个人微信推送：在 Server酱 Turbo 获取 SendKey，不要提交真实值
WECHAT_SENDKEY=SCT你的SendKey
# 本地手动运行 src.delivery 时，图片也必须先上传到公开 HTTPS 地址

# QQ 邮箱推送：必须使用 SMTP 授权码，不能填写 QQ 登录密码
QQ_EMAIL_USER=你的QQ邮箱@qq.com
QQ_EMAIL_AUTH_CODE=你的SMTP授权码
# 可选：不填时默认发送给 QQ_EMAIL_USER 自己
# EMAIL_TO=收件邮箱@example.com
