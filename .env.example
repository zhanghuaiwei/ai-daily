# 复制为 .env 并填写云端模型 API Key；.env 已被 gitignore。
# 默认顺序：GPT → DeepSeek → WorkBuddy/TokenHub → 千问。
LLM_PROVIDER_ORDER=gpt,deepseek,workbuddy,qwen

# GPT / OpenAI 兼容云端接口。Ollama、localhost 和 11434 端口会被拒绝。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=medium

# 可选云端故障转移。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

WORKBUDDY_API_KEY=
WORKBUDDY_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3
WORKBUDDY_MODEL=hy3

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=0

# Server酱 Turbo SendKey：每日 Markdown 只通过这个渠道推送。
WECHAT_SENDKEY=
